<Window x:Class="UciGui.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:properties="clr-namespace:UciGui.Properties"
        xmlns:converters="clr-namespace:UciGui.Converters"
        xmlns:userControls="clr-namespace:UciGui.UserControls"
        xmlns:ts="clr-namespace:UciGui.TemplateSelectors"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:viewmodels="clr-namespace:UciGui.ViewModels" 
        d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowViewModel}"
        mc:Ignorable="d"
        Title="UCI GUI"
        Height="720"
        Width="1100"
        MinHeight="620"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="btvc"/>
        <converters:BooleanToInverseVisibilityConverter x:Key="btivc"/>
        <ts:OptionsDataTemplateSelector x:Key="odts"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#20262E"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#CDD5DF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#CDD5DF"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#3767D6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="520"/>
            <ColumnDefinition Width="2*" MinWidth="300"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#E1E6EC" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="POSITION" FontSize="11" FontWeight="SemiBold" Foreground="#768195" Margin="0,0,0,7"/>
                        <TextBox Text="{Binding Fen, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="13"/>
                    </StackPanel>
                    <Button Grid.Column="1" Width="112" Height="43" VerticalAlignment="Bottom"
                            Content="GO" Command="{Binding GoCommand}" Visibility="{Binding IsBusy, Converter={StaticResource btivc}}"
                            Background="#248A55" FontSize="13" FontWeight="SemiBold"/>
                    <Button Grid.Column="1" Width="112" Height="43" VerticalAlignment="Bottom"
                            Command="{Binding StopCommand}" Visibility="{Binding IsBusy, Converter={StaticResource btvc}}"
                            Background="#D84A4A" FontSize="13" FontWeight="SemiBold">
                        <Grid Width="112">
                            <ProgressBar IsIndeterminate="True" Height="43" BorderThickness="0" Foreground="#C83C3C" Background="#D84A4A"/>
                            <TextBlock Text="STOP" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="White" BorderBrush="#E1E6EC" BorderThickness="1" CornerRadius="8" Padding="12">
                <Viewbox Stretch="Uniform">
                    <userControls:ChessBoard1 Fen="{Binding Fen}" Width="660" Height="520"/>
                </Viewbox>
            </Border>

            <Border Grid.Row="2" Background="White" BorderBrush="#E1E6EC" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="BEST MOVE" FontSize="11" FontWeight="SemiBold" Foreground="#768195"/>
                        <TextBlock Text="{Binding BestMove, TargetNullValue=—}" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="PONDER" FontSize="11" FontWeight="SemiBold" Foreground="#768195"/>
                        <TextBlock Text="{Binding Ponder, TargetNullValue=—}" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Column="1" Background="White" BorderBrush="#E1E6EC" BorderThickness="1" CornerRadius="8">
            <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="#EEF1F4" BorderThickness="0,0,0,1" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="Engine options" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding UciEngineExe, Source={x:Static properties:Settings.Default}, StringFormat=Using {0}}" FontSize="12" Foreground="#768195" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                <ItemsControl ItemsSource="{Binding Options}" ItemTemplateSelector="{StaticResource odts}">
                    <ItemsControl.Resources>
                        <DataTemplate x:Key="spinTemplate">
                            <Border BorderBrush="#EEF1F4" BorderThickness="0,0,0,1" Padding="0,10">
                                <DockPanel>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Width="150" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                    <Slider Value="{Binding Default}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" SmallChange="1" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="ValueChanged">
                                            <prism:InvokeCommandAction Command="{Binding DataContext.ValueChangedCommand, RelativeSource={RelativeSource AncestorType=Window}}" TriggerParameterPath=""/>
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                            </Slider>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                                <DataTemplate x:Key="checkTemplate">
                                    <Border BorderBrush="#EEF1F4" BorderThickness="0,0,0,1" Padding="0,8">
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding Default}" Command="{Binding DataContext.CheckBoxChangedCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}"/>
                                    </Border>
                        </DataTemplate>
                        <DataTemplate x:Key="stringTemplate">
                            <Border BorderBrush="#EEF1F4" BorderThickness="0,0,0,1" Padding="0,10">
                                <DockPanel>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Width="150" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                    <TextBox Text="{Binding Default}">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="TextChanged">
                                                <prism:InvokeCommandAction Command="{Binding DataContext.TextChangedCommand, RelativeSource={RelativeSource AncestorType=Window}}" TriggerParameterPath=""/>
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                        <DataTemplate x:Key="buttonTemplate">
                            <Button Content="{Binding Name}" Command="{Binding DataContext.ButtonChangedCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="2"/>
                        </DataTemplate>
                        <DataTemplate x:Key="comboTemplate">
                            <Border BorderBrush="#EEF1F4" BorderThickness="0,0,0,1" Padding="0,10">
                                <DockPanel>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Width="150" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                    <ComboBox ItemsSource="{Binding Items}" SelectedItem="{Binding Default}">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="SelectionChanged">
                                                <prism:InvokeCommandAction Command="{Binding DataContext.SelectionChangedCommand, RelativeSource={RelativeSource AncestorType=Window}}" TriggerParameterPath=""/>
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </ComboBox>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.Resources>
                </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" CornerRadius="8" Background="#CCFFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource btvc}}" d:IsHidden="True"/>
    </Grid>
</Window>
