<UserControl x:Class="UciGui.UserControls.ChessBoard1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:UciGui.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="450" x:Name="uc">
    <UserControl.Resources>
        <converters:CellColorConverter x:Key="CellColorConverter"/>
        <converters:ShapeTypeConverter x:Key="ShapeTypeConverter"/>
        <Style x:Key="TextBlockStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PieceTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockStyle}">
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="44"/>
            <Setter Property="Foreground" Value="#20262E"/>
        </Style>
        <Style x:Key="LegendTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockStyle}">
            <Setter Property="FontSize" Value="20"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="16*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <UniformGrid Grid.Column="0" Grid.Row="0" Rows="8">
                <TextBlock Style="{StaticResource LegendTextBlockStyle}" Text="8"/>
                <TextBlock Style="{StaticResource LegendTextBlockStyle}" Text="7"/>
                <TextBlock Style="{StaticResource LegendTextBlockStyle}" Text="6"/>
                <TextBlock Style="{StaticResource LegendTextBlockStyle}" Text="5"/>
                <TextBlock Style="{StaticResource LegendTextBlockStyle}" Text="4"/>
                <TextBlock Style="{StaticResource LegendTextBlockStyle}" Text="3"/>
                <TextBlock Style="{StaticResource LegendTextBlockStyle}" Text="2"/>
                <TextBlock Style="{StaticResource LegendTextBlockStyle}" Text="1"/>
            </UniformGrid>
            <UniformGrid Grid.Column="1" Grid.Row="1" Columns="8">
                <TextBlock Style="{StaticResource LegendTextBlockStyle}" Text="a"/>
                <TextBlock Style="{StaticResource LegendTextBlockStyle}" Text="b"/>
                <TextBlock Style="{StaticResource LegendTextBlockStyle}" Text="c"/>
                <TextBlock Style="{StaticResource LegendTextBlockStyle}" Text="d"/>
                <TextBlock Style="{StaticResource LegendTextBlockStyle}" Text="e"/>
                <TextBlock Style="{StaticResource LegendTextBlockStyle}" Text="f"/>
                <TextBlock Style="{StaticResource LegendTextBlockStyle}" Text="g"/>
                <TextBlock Style="{StaticResource LegendTextBlockStyle}" Text="h"/>
            </UniformGrid>
            <Border Grid.Column="1" Grid.Row="0" BorderBrush="Black" BorderThickness="1">
                <ItemsControl ItemsSource="{Binding Squares, ElementName=uc}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Grid.Row" Value="{Binding Row}"/>
                            <Setter Property="Grid.Column" Value="{Binding Column}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                            </Grid>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent" AllowDrop="True"
                                  PreviewMouseLeftButtonDown="Square_PreviewMouseLeftButtonDown"
                                  PreviewMouseMove="Square_PreviewMouseMove"
                                  DragOver="Square_DragOver"
                                  Drop="Square_Drop">
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <MultiBinding Converter="{StaticResource CellColorConverter}">
                                            <Binding Path="Column"/>
                                            <Binding Path="Row"/>
                                        </MultiBinding>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <TextBlock Style="{StaticResource PieceTextBlockStyle}">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource ShapeTypeConverter}">
                                            <Binding Path="Piece.ShapeType"/>
                                            <Binding Path="Piece.ColorType"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>

        <Border Grid.Column="1" Margin="8,0,0,0" Padding="8" Background="#F7F8FA"
                BorderBrush="#E1E6EC" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="PIECE BANK" FontSize="11" FontWeight="SemiBold" Foreground="#768195" Margin="0,0,0,6"/>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding AvailablePieces, ElementName=uc}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="#E1E6EC" BorderThickness="1" CornerRadius="4" Margin="2"
                                    PreviewMouseLeftButtonDown="PalettePiece_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="PieceSource_PreviewMouseMove">
                                <TextBlock Style="{StaticResource PieceTextBlockStyle}" FontSize="26">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource ShapeTypeConverter}">
                                            <Binding Path="ShapeType"/>
                                            <Binding Path="ColorType"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="CAPTURED · drag to restore" FontSize="10" FontWeight="SemiBold" Foreground="#768195" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <Border Grid.Row="1" Background="White" BorderBrush="#E1E6EC" BorderThickness="1" CornerRadius="4"
                            AllowDrop="True" DragOver="CapturedTray_DragOver" Drop="CapturedTray_Drop">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding CapturedPieces, ElementName=uc}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F7F8FA" BorderBrush="#E1E6EC" BorderThickness="1" CornerRadius="4" Margin="2"
                                                PreviewMouseLeftButtonDown="CapturedPiece_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="PieceSource_PreviewMouseMove">
                                            <TextBlock Style="{StaticResource PieceTextBlockStyle}" FontSize="25" Margin="3">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource ShapeTypeConverter}">
                                                        <Binding Path="ShapeType"/>
                                                        <Binding Path="ColorType"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
